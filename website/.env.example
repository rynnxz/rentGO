# ============================================================================
# RentGo Environment Variables (.env.example)
# Salin file ini menjadi .env.local untuk pengembangan lokal.
# Jangan pernah melakukan commit file .env atau .env.local ke repositori Git!
# ============================================================================

# 1. Domain & Surface URLs
# Di lokal gunakan localhost:3000; di produksi gunakan rentgo.my.id
ROOT_DOMAIN=rentgo.my.id
NEXT_PUBLIC_LANDING_URL=https://rentgo.my.id
NEXT_PUBLIC_BOOK_URL=https://book.rentgo.my.id
NEXT_PUBLIC_ADMIN_URL=https://admin.rentgo.my.id

# 2. Firebase Authentication (Google Sign-In - Client SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opsional saat pengujian lokal dengan Firebase Auth Emulator (misal 127.0.0.1:9099)
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# 3. Firebase Admin SDK (Server-Only untuk verifikasi ID token & session cookie)
# Isi dengan string Base64 dari file JSON Service Account Firebase
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# 4. Supabase PostgreSQL & Storage (Server-Only, RLS deny-all untuk anon)
SUPABASE_URL=https://veuhrdylqvgmdchjibje.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 5. Google Gemini API (Free Tier - Google AI Studio)
# SDK: @google/genai (interactions.create dengan structured JSON schema)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 6. Role-Based Access Control (RBAC) & Keamanan Operasional
# Daftar email yang otomatis mendapat role 'admin' saat pertama kali login (dipisahkan koma)
ADMIN_EMAILS=akbarriansyah339@gmail.com,admin@rentgo.my.id

# Secret untuk mengamankan endpoint GET /api/cron/housekeeping (Vercel Cron)
CRON_SECRET=replace-with-32-char-random-secret

# 7. Informasi Pembayaran & Kontak Operasional Rental
PAYMENT_BANK_INFO="Bank Mandiri 105-00-8899776-5 a.n. PT RentGo Transportasi Medan"
WHATSAPP_NUMBER=6281260009988
