# ============================================================================
# RentGo Medan v1.2.0 - Environment Variable Template (.env.example)
# Salin file ini menjadi .env.local lalu isi nilainya sesuai akun cloud Anda.
# JANGAN PERNAH meng-commit nilai rahasia ke repositori Git!
# ============================================================================

# 1. Konfigurasi Aplikasi & URL Single-Domain (/, /book, /admin)
NODE_ENV="development"
ROOT_DOMAIN="localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_LANDING_URL="http://localhost:3000"
NEXT_PUBLIC_BOOK_URL="http://localhost:3000/book"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3000/admin"

# 2. Firebase Client (Khusus Autentikasi: Google OAuth & Email/Password)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=""

# 3. Firebase Admin SDK (Verifikasi Token Server-Side)
FIREBASE_AUTH_EMULATOR_HOST=""
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=""

# 4. Supabase PostgreSQL & Cloud Storage (7 Tabel + Bucket Foto)
SUPABASE_PROJECT_REF=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_STORAGE_BUCKET="vehicles"
SUPABASE_SERVICE_ROLE_KEY=""

# 5. Google Gemini AI (Rekomendasi Armada Cerdas, Rate Limit 10/menit)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
GEMINI_RATE_LIMIT_PER_MINUTE="10"

# 6. Midtrans Sandbox (Gateway Pembayaran QRIS)
MIDTRANS_MERCHANT_ID="rentgo-test"
MIDTRANS_SERVER_KEY=""
MIDTRANS_ENV="sandbox"

# 7. RBAC Administrator, Cron Housekeeping & Kontak Operasional
ADMIN_EMAILS="akbarriansyah339@gmail.com,admin@rentgo.my.id"
CRON_SECRET=""
PAYMENT_BANK_INFO="QRIS Midtrans Sandbox (Merchant: rentgo-test) a.n. PT RentGo Transportasi Medan"
WHATSAPP_NUMBER="6281260009988"
